@@ -158,6 +158,16 @@ export function calculateBoundingBox(
     }
   }
 
+  // An empty borderTiles (e.g. an alive player transiently between tile
+  // ownership and their next border/cluster recalculation) would otherwise
+  // leak the Infinity/-Infinity sentinels straight into the returned box -
+  // downstream consumers computing max-min (e.g. NameBoxCalculator's
+  // createGrid) then try to allocate an Array(-Infinity) and crash with a
+  // RangeError. Degenerate input gets a degenerate (zero-size) box instead.
+  if (minX === Infinity) {
+    minX = maxX = minY = maxY = 0;
+  }
+
   return { min: new Cell(minX, minY), max: new Cell(maxX, maxY) };
 }
 
